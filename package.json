{
  "name": "steward",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --sort build",
    "dev:web": "pnpm --filter @steward/web dev:local",
    "dev:agent": "pnpm --filter @steward/agent dev",
    "start:web": "pnpm --filter @steward/web start:local",
    "start:agent": "pnpm --filter @steward/agent start",
    "preflight": "pnpm --filter @steward/agent preflight",
    "typecheck": "pnpm -r --sort typecheck",
    "test": "pnpm -r --sort test",
    "test:e2e": "pnpm --filter @steward/web test:e2e",
    "test:e2e:update": "pnpm --filter @steward/web test:e2e:update",
    "trace:smoke": "pnpm build && pnpm --filter @steward/agent start:smoke"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
