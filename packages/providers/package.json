{
  "name": "@steward/providers",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm --filter @steward/db build",
    "test": "vitest run"
  },
  "dependencies": {
    "@steward/contracts": "workspace:*",
    "@steward/db": "workspace:*",
    "livekit-server-sdk": "2.17.0",
    "stripe": "22.4.0",
    "zod": "4.4.3"
  }
}
