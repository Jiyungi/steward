{
  "name": "@steward/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @steward/contracts build",
    "dev": "next dev",
    "dev:local": "node scripts/next-local.mjs dev",
    "prebuild": "pnpm --filter @steward/contracts build",
    "build": "next build",
    "start": "next start",
    "start:local": "node scripts/next-local.mjs start",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots"
  },
  "dependencies": {
    "@livekit/protocol": "1.50.4",
    "@react-three/drei": "10.7.7",
    "@react-three/fiber": "9.7.0",
    "@steward/config": "workspace:*",
    "@steward/contracts": "workspace:*",
    "@steward/db": "workspace:*",
    "@steward/providers": "workspace:*",
    "@steward/ui": "workspace:*",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.111.0",
    "dotenv": "17.4.2",
    "livekit-client": "2.21.0",
    "livekit-server-sdk": "2.17.0",
    "motion": "12.43.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "three": "0.185.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/three": "0.185.3",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
