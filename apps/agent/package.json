{
  "name": "@steward/agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsx src/index.ts dev",
    "start": "node dist/index.js start",
    "preflight": "tsx src/preflight.ts",
    "start:preflight": "node dist/preflight.js",
    "start:smoke": "node dist/smoke-cli.js"
  },
  "dependencies": {
    "@livekit/agents": "1.6.1",
    "@livekit/agents-plugin-deepgram": "1.6.1",
    "@livekit/agents-plugin-openai": "1.6.1",
    "@livekit/rtc-node": "0.13.33",
    "@langfuse/openai": "5.10.0",
    "@steward/config": "workspace:*",
    "@steward/contracts": "workspace:*",
    "@steward/observability": "workspace:*",
    "dotenv": "17.4.2",
    "openai": "7.3.0"
  }
}
