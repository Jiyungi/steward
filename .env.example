# =============================================================================
# 1. EXISTING ESSENTIAL CREDENTIALS
# The local .env already has these five values. Do not replace them.
# OPENAI_API_KEY is the a1mobile model gateway key, not a second AI provider.
# =============================================================================
OPENAI_API_KEY=
A1MOBILE_TEAM_KEY=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# =============================================================================
# 2. SAFE DEFAULTS
# Copy these exactly for local development; they are not secrets.
# =============================================================================
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
DEMO_GUEST_ACCESS_ENABLED=true
DEMO_PROPERTY_SLUG=steward-demo-home
GUEST_LINK_EXPIRY_DAYS=14
MAX_PARALLEL_VENDOR_CALLS=2

A1MOBILE_BASE_URL=https://hack.a1mobile.com
A1MOBILE_MCP_URL=https://hack.a1mobile.com/mcp/
OPENAI_BASE_URL=https://h3zqfzovcybu5annkciuqf47mu0cbczd.lambda-url.us-east-2.on.aws/openai/v1
OPENAI_MODEL=openai.gpt-5.6-terra
VOICE_LLM_MODEL=google/gemma-4-31b-it
VOICE_LLM_VISION_ENABLED=false

LIVEKIT_AGENT_NAME=steward

DEEPGRAM_STT_MODEL=flux-general-en
DEEPGRAM_TTS_MODEL=aura-2-thalia-en
DEEPGRAM_TTS_SPEED=1.0

LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development

# =============================================================================
# 3. GET THESE NEXT - REQUIRED FOR THE COMPLETE VOICE CALL
# =============================================================================

# Returned when the a1mobile phone number is claimed.
A1MOBILE_PHONE_NUMBER=
A1MOBILE_SIP_USERNAME=
A1MOBILE_SIP_PASSWORD=

# This is the same public wss:// value used for LIVEKIT_URL.
NEXT_PUBLIC_LIVEKIT_URL=

# Created in LiveKit after the a1mobile SIP credentials are available.
LIVEKIT_SIP_INBOUND_TRUNK_ID=
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=
LIVEKIT_SIP_DISPATCH_RULE_ID=

# One Deepgram key powers both Flux STT and Aura-2 TTS.
DEEPGRAM_API_KEY=

# =============================================================================
# 4. ADD WHEN BUILDING THE APP UI AND DATABASE
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# =============================================================================
# 5. ADD WHEN BUILDING PAYMENTS - STRIPE TEST MODE ONLY
# =============================================================================
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# =============================================================================
# 6. ADD WHEN BUILDING MONITORING
# =============================================================================
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# =============================================================================
# 7. OPTIONAL - LEAVE BLANK FOR THE CONTROLLED HACKATHON DEMO
# =============================================================================
GOOGLE_MAPS_API_KEY=
